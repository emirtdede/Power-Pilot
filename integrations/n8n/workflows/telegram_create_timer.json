{
  "name": "Power Pilot - Telegram Zamanlayıcı Kurma",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18456/api/v1/tasks/timer",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "YOUR_POWER_PILOT_API_KEY_HERE"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"Telegram Timer\",\n  \"action\": \"shutdown\",\n  \"durationMs\": 3600000\n}"
      },
      "id": "2",
      "name": "Power Pilot HTTP API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Power Pilot HTTP API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
